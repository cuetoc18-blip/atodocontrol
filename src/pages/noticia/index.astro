---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase.js';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const client = supabase();
const { data: noticia } = await client
  .from('noticias')
  .select('*')
  .eq('id', id)
  .eq('publicada', true)
  .single();

if (!noticia) return Astro.redirect('/');

function hace(d) {
  if (!d) return '';
  const ms = Date.now() - new Date(d).getTime();
  const m = Math.max(0, Math.floor(ms / 60000));
  if (m < 1) return 'Hace un momento';
  if (m < 60) return `Hace ${m} min`;
  const h = Math.floor(m / 60);
  if (h < 24) return h === 1 ? 'Hace 1 hora' : `Hace ${h} horas`;
  const days = Math.floor(h / 24);
  return days === 1 ? 'Hace 1 día' : `Hace ${days} días`;
}

function foto(n) {
  const u = n?.imagen_url || '';
  if (!u || /(instagram|facebook|twitter|x)\.com/i.test(u)) return '';
  const m = u.match(/\/noticias-imagenes\/(.+)$/);
  return m ? '/media/' + m[1] : u;
}
---
<Layout title={noticia.titulo} description={noticia.resumen || ''} url={`https://atodocontrol.co/noticia/${noticia.id}`}>
  <article class="noticia">
    <div class="meta">
      <span class="sec">{noticia.categoria || 'General'}</span>
      <span class="time">{hace(noticia.fecha_publicacion || noticia.created_at)}</span>
    </div>
    <h1>{noticia.titulo}</h1>
    {noticia.resumen && <p class="lead">{noticia.resumen}</p>}
    
    {foto(noticia) && (
      <img src={foto(noticia)} alt={noticia.titulo} class="portada" />
    )}

    <div class="contenido" set:html={noticia.contenido}></div>

    {noticia.instagram_url && (
      <div class="embed">
        <blockquote class="instagram-media" data-instgrm-permalink={noticia.instagram_url}></blockquote>
        <script async src="//www.instagram.com/embed.js"></script>
      </div>
    )}
  </article>

  <style>
    .noticia { max-width: 720px; margin: 0 auto; padding: 24px 20px 60px; }
    .meta { display: flex; gap: 10px; align-items: baseline; margin-bottom: 12px; }
    .sec { color: #c1121f; font-size: .75rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .time { color: #94a3b8; font-size: .8rem; }
    h1 { font-family: Georgia, serif; font-size: 1.8rem; line-height: 1.2; margin: 0 0 16px; color: #111; }
    .lead { color: #475569; font-size: 1.05rem; line-height: 1.5; margin: 0 0 20px; }
    .portada { width: 100%; border-radius: 8px; margin: 0 0 24px; }
    .contenido { font-size: 1.05rem; line-height: 1.7; color: #1e293b; }
    .contenido p { margin: 0 0 16px; }
    .embed { margin-top: 32px; }
  </style>
</Layout>
