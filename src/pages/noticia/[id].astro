---
import Layout from '../../layouts/Layout.astro';
import { supabase, igPermalink, xStatusId, fbPermalink } from '../../lib/supabase.js';

const { id } = Astro.params;
const client = supabase();
const { data } = await client.from('noticias').select('*').eq('id', id).maybeSingle();

if (!data) {
  return Astro.redirect('/');
}

const title = `${data.titulo} | A Todo Control`;
const description = (data.resumen || data.titulo || '').slice(0, 180);
const image = data.imagen_url && !/(instagram|facebook|twitter|x)\.com/i.test(data.imagen_url || '')
  ? data.imagen_url
  : 'https://atodocontrol.co/og-default.jpg';
const url = `https://atodocontrol.co/noticia/${id}`;
const blob = [data.instagram_url, data.x_url, data.facebook_url, data.video_url, data.contenido].filter(Boolean).join('\n');
const ig = igPermalink(data.instagram_url || blob);
const xid = xStatusId(data.x_url || blob);
const fb = fbPermalink(data.facebook_url || blob);
const fecha = new Date(data.fecha_publicacion || data.created_at);
const fechaTxt = fecha.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
const horaTxt = fecha.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true });
function formatBody(t) {
  return String(t || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');
}
const pars = String(data.contenido || '').split('\n').filter(p => p.trim()).map(formatBody);
const share = encodeURIComponent(url);
const shareT = encodeURIComponent(data.titulo || '');
---
<Layout title={title} description={description} image={image} url={url}>
  <div class="article-wrap">
    <article class="article-card">
      {data.imagen_url && !/(instagram|facebook|twitter|x)\.com/i.test(data.imagen_url) && (
        <img class="article-image" src={data.imagen_url} alt={data.titulo} />
      )}
      <div class="article-body">
        <span class="category">{data.categoria || 'General'}</span>
        <h1>{data.titulo}</h1>
        {data.resumen && <p class="dek">{data.resumen}</p>}
        {ig && (
          <div class="ig-embed">
            <iframe src={`${ig}embed`} allowfullscreen loading="lazy" title="Instagram"></iframe>
            <p style="text-align:center"><a href={ig} target="_blank" rel="noopener">Ver en Instagram</a></p>
          </div>
        )}
        {xid && (
          <div class="x-embed">
            <blockquote class="twitter-tweet" data-dnt="true" data-media-max-width="550">
              <a href={`https://x.com/i/status/${xid}`}>Ver publicación en X</a>
            </blockquote>
            <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
          </div>
        )}
        {fb && (
          <div class="fb-embed">
            <iframe
              src={`https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(fb)}&show_text=true&width=500`}
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
              title="Publicación de Facebook"
            ></iframe>
            <p style="text-align:center"><a href={fb} target="_blank" rel="noopener">Ver en Facebook</a></p>
          </div>
        )}
        <div class="byline">
          <div>
            <div class="byline-name">A Todo Control</div>
            <div class="byline-date">{fechaTxt}</div>
            <div>{horaTxt}</div>
          </div>
          <div class="share">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener" title="Facebook"><img src="/share-facebook.png" alt="Facebook" /></a>
            <a href={`https://twitter.com/intent/tweet?url=${share}&text=${shareT}`} target="_blank" rel="noopener" title="X"><img src="/share-x.webp" alt="X" /></a>
            <a href={`https://api.whatsapp.com/send?text=${shareT}%20${share}`} target="_blank" rel="noopener" title="WhatsApp"><img src="/share-whatsapp.webp" alt="WhatsApp" /></a>
          </div>
        </div>
        <div class="content">
          {pars.map(p => <p set:html={p} />)}
        </div>
      </div>
    </article>
  </div>
  <script define:vars={{ id }}>
    try {
      const key = 'vista_' + id;
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, '1');
        const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
        const c = createClient('https://hlqdkosclnmmdhasoupt.supabase.co', 'sb_publishable_hw4WsIr-GvZU7PEu_KNNEw_tC-98Nst');
        await c.rpc('increment_vistas', { nid: id });
      }
    } catch (e) {}
  </script>
</Layout>
