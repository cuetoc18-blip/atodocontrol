---
import Layout from '../../layouts/Layout.astro';
import { supabase, igPermalink, xStatusId, fbPermalink } from '../../lib/supabase.js';

const { id } = Astro.params;
const client = supabase();
const { data } = await client.from('noticias').select('*').eq('id', id).maybeSingle();

if (!data) {
  return Astro.redirect('/');
}

const title = `${data.titulo} | A Todo Control`;
const description = (data.resumen || data.titulo || '').slice(0, 180);
const image = data.imagen_url && !/(instagram|facebook|twitter|x)\.com/i.test(data.imagen_url || '')
  ? `https://atodocontrol.co/og/${id}.jpg`
  : 'https://atodocontrol.co/og-default.jpg';
const url = `https://atodocontrol.co/noticia/${id}`;
const fecha = new Date(data.fecha_publicacion || data.created_at);
const fechaTxt = fecha.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
const horaTxt = fecha.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true });
const share = encodeURIComponent(url);
const shareT = encodeURIComponent(data.titulo || '');
const linkRe = /https?:\/\/[^\s<>"']+/gi;

function fotoLocal(u) {
  const m = String(u || '').match(/\/noticias-imagenes\/(.+)$/);
  return m ? '/foto/' + m[1] : u;
}
function formatBody(t) {
  return String(t || '')
    .replace(/&/g, '&')
    .replace(/</g, '<')
    .replace(/>/g, '>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');
}
function redDe(texto) {
  const ig = igPermalink(texto);
  const xid = xStatusId(texto);
  const fb = fbPermalink(texto);
  if (ig) return { tipo: 'ig', ig };
  if (xid) return { tipo: 'x', xid };
  if (fb) return { tipo: 'fb', fb, video: /\/(reel|videos|watch|share\/[vr])\//i.test(fb) };
  return null;
}
function bloques(texto) {
  const out = [];
  for (const linea of String(texto || '').split('\n')) {
    const t = linea.trim();
    if (!t) continue;
    const urls = t.match(linkRe) || [];
    const social = urls.map(u => ({ u, red: redDe(u) })).filter(x => x.red);
    if (!social.length) {
      out.push({ tipo: 'p', html: formatBody(t) });
      continue;
    }
    let limpio = t;
    for (const s of social) limpio = limpio.replace(s.u, '');
    if (limpio.trim()) out.push({ tipo: 'p', html: formatBody(limpio.trim()) });
    for (const s of social) out.push(s.red);
  }
  return out;
}
const cuerpo = bloques(data.contenido);
const campo = redDe(data.instagram_url || data.x_url || data.facebook_url || data.video_url || '');
const campoYaEsta = campo && cuerpo.some(b =>
  (campo.tipo === 'ig' && b.ig === campo.ig) ||
  (campo.tipo === 'x' && b.xid === campo.xid) ||
  (campo.tipo === 'fb' && b.fb === campo.fb)
);
const hayX = cuerpo.some(b => b.tipo === 'x') || (campo && !campoYaEsta && campo.tipo === 'x');
---
<Layout title={title} description={description} image={image} url={url}>
  <div class="article-wrap">
    <article class="article-card">
      {data.imagen_url && !/(instagram|facebook|twitter|x)\.com/i.test(data.imagen_url) && (
        <img class="article-image" src={fotoLocal(data.imagen_url)} alt={data.titulo} />
      )}
      <div class="article-body">
        <span class="category">{data.categoria || 'General'}</span>
        <h1>{data.titulo}</h1>
        {data.resumen && <p class="dek">{data.resumen}</p>}
        {campo && !campoYaEsta && campo.tipo === 'ig' && (
          <div class="ig-embed"><iframe src={`${campo.ig}embed`} allowfullscreen loading="lazy" title="Instagram"></iframe></div>
        )}
        {campo && !campoYaEsta && campo.tipo === 'x' && (
          <div class="x-embed"><blockquote class="twitter-tweet" data-dnt="true"><a href={`https://x.com/i/status/${campo.xid}`}>Ver en X</a></blockquote></div>
        )}
        {campo && !campoYaEsta && campo.tipo === 'fb' && (
          <div class="fb-embed"><iframe src={`https://www.facebook.com/plugins/${campo.video ? 'video' : 'post'}.php?href=${encodeURIComponent(campo.fb)}&show_text=true&width=500`} allowfullscreen loading="lazy" title="Facebook"></iframe></div>
        )}
        <div class="byline">
          <div>
            <div class="byline-name">A Todo Control</div>
            <div class="byline-date">{fechaTxt}</div>
            <div>{horaTxt}</div>
          </div>
          <div class="share">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener" title="Facebook"><img src="/share-facebook.png" alt="Facebook" /></a>
            <a href={`https://twitter.com/intent/tweet?url=${share}&text=${shareT}`} target="_blank" rel="noopener" title="X"><img src="/share-x.webp" alt="X" /></a>
            <a href={`https://api.whatsapp.com/send?text=${shareT}%20${share}`} target="_blank" rel="noopener" title="WhatsApp"><img src="/share-whatsapp.webp" alt="WhatsApp" /></a>
          </div>
        </div>
        <div class="content">
          {cuerpo.map(b => b.tipo === 'p' ? (
            <p set:html={b.html} />
          ) : b.tipo === 'ig' ? (
            <div class="ig-embed"><iframe src={`${b.ig}embed`} allowfullscreen loading="lazy" title="Instagram"></iframe></div>
          ) : b.tipo === 'x' ? (
            <div class="x-embed"><blockquote class="twitter-tweet" data-dnt="true"><a href={`https://x.com/i/status/${b.xid}`}>Ver en X</a></blockquote></div>
          ) : (
            <div class="fb-embed"><iframe src={`https://www.facebook.com/plugins/${b.video ? 'video' : 'post'}.php?href=${encodeURIComponent(b.fb)}&show_text=true&width=500`} allowfullscreen loading="lazy" title="Facebook"></iframe></div>
          ))}
        </div>
      </div>
    </article>
  </div>
  {hayX && <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}
  <script define:vars={{ id }} is:inline>
    (function () {
      try {
        var key = 'vista_' + id;
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, '1');
        fetch('/api/vistas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nid: id })
        });
      } catch (e) {}
    })();
  </script>
</Layout>
