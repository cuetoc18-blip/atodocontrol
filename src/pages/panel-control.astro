---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const cookie = Astro.request.headers.get('cookie') || '';
const tieneSesion = cookie.includes('vb_session=');
if (!tieneSesion) {
  return Astro.redirect('/login');
}
---
<Layout title="Panel de Administración | A Todo Control">
  <div class="admin">
    <h1>Panel de Administración</h1>

    <nav class="admin-nav">
      <a href="#noticias">Noticias</a>
      <a href="#reels">Reels</a>
    </nav>

    <section id="noticias">
      <h2>Publicar Noticia</h2>
      <p>Aquí va tu formulario actual de noticias.</p>
    </section>

    <section id="reels" class="reels-admin">
      <h2>Subir Reel (convierte a HLS)</h2>
      <form id="reel-form">
        <label>Título</label>
        <input type="text" name="titulo" required />

        <label>Descripción (opcional)</label>
        <textarea name="descripcion" rows="2"></textarea>

        <label>Video (MP4)</label>
        <input type="file" name="video" accept="video/mp4,video/*" required />

        <label>Foto de portada</label>
        <input type="file" name="imagen" accept="image/*" />

        <button type="submit">Convertir a HLS y publicar</button>
      </form>
      <div id="reel-status"></div>
      <div id="reel-log"></div>
    </section>
  </div>

  <script type="module">
    const reelForm = document.getElementById('reel-form');
    const reelStatus = document.getElementById('reel-status');
    const reelLog = document.getElementById('reel-log');

    function log(msg) {
      reelLog.textContent = msg;
    }

    let ffmpeg;
    let ffmpegReady = false;

    async function loadFFmpeg() {
      if (ffmpegReady) return;
      log('Cargando convertidor...');
      const { FFmpeg } = await import('https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.10/dist/esm/index.js');
      const { toBlobURL } = await import('https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/esm/index.js');
      ffmpeg = new FFmpeg();
      const base = 'https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/esm';
      await ffmpeg.load({
        coreURL: await toBlobURL(`${base}/ffmpeg-core.js`, 'text/javascript'),
        wasmURL: await toBlobURL(`${base}/ffmpeg-core.wasm`, 'application/wasm'),
      });
      ffmpegReady = true;
      log('Convertidor listo');
    }

    async function uploadBlob(path, blob) {
      const urlRes = await fetch('/api/reels', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ action: 'get-upload-url', fileName: path })
      });
      const { signedUrl, path: savedPath } = await urlRes.json();
      if (!urlRes.ok) throw new Error('No se pudo obtener URL');
      const put = await fetch(signedUrl, { method: 'PUT', body: blob });
      if (!put.ok) throw new Error('Error subiendo ' + path);
      return savedPath || path;
    }

    if (reelForm) {
      reelForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        reelStatus.textContent = 'Iniciando...';
        reelStatus.style.color = '#333';
        reelLog.textContent = '';

        const titulo = reelForm.querySelector('[name="titulo"]').value.trim();
        const descripcion = reelForm.querySelector('[name="descripcion"]').value.trim();
        const videoFile = reelForm.querySelector('[name="video"]').files[0];
        const imagenFile = reelForm.querySelector('[name="imagen"]').files[0];

        if (!titulo || !videoFile) {
          reelStatus.textContent = 'Error: Título y video son obligatorios';
          reelStatus.style.color = 'red';
          return;
        }

        try {
          await loadFFmpeg();
          log('Leyendo video...');
          const { fetchFile } = await import('https://cdn.jsdelivr.net/npm/@ffmpeg/util@0.12.1/dist/esm/index.js');
          await ffmpeg.writeFile('input.mp4', await fetchFile(videoFile));

          const folder = `reel-${Date.now()}`;
          log('Convirtiendo a HLS (esto puede tardar)...');
          await ffmpeg.exec([
            '-i', 'input.mp4',
            '-c:v', 'libx264', '-c:a', 'aac',
            '-hls_time', '4',
            '-hls_playlist_type', 'vod',
            '-hls_segment_filename', 'seg_%03d.ts',
            '-f', 'hls', 'index.m3u8'
          ]);

          log('Subiendo segmentos HLS...');
          const dirFiles = await ffmpeg.listDir('.');
          const hlsUploads = [];
          for (const f of dirFiles) {
            if (!f.name.endsWith('.ts') && f.name !== 'index.m3u8') continue;
            const data = await ffmpeg.readFile(f.name);
            const blob = new Blob([data.buffer], {
              type: f.name.endsWith('.m3u8') ? 'application/vnd.apple.mpegurl' : 'video/mp2t'
            });
            hlsUploads.push(uploadBlob(`${folder}/${f.name}`, blob));
          }
          await Promise.all(hlsUploads);
          log(`Subidos ${hlsUploads.length} archivos HLS`);

          let imagen_path = null;
          if (imagenFile) {
            log('Subiendo portada...');
            imagen_path = await uploadBlob(`${folder}/poster${imagenFile.name.slice(imagenFile.name.lastIndexOf('.'))}`, imagenFile);
          }

          log('Guardando reel...');
          const saveRes = await fetch('/api/reels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              action: 'save-reel',
              titulo,
              descripcion,
              video_path: `${folder}/index.m3u8`,
              imagen_path,
              hls_path: `${folder}/index.m3u8`
            })
          });
          const saveData = await saveRes.json();
          if (!saveRes.ok) throw new Error(saveData.error || 'Error guardando');

          reelStatus.textContent = 'Reel publicado en HLS';
          reelStatus.style.color = 'green';
          reelForm.reset();
          log('');
        } catch (err) {
          reelStatus.textContent = 'Error: ' + err.message;
          reelStatus.style.color = 'red';
        }
      });
    }
  </script>

  <style>
    .admin {
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #fff;
    }
    .admin h1 { margin-bottom: 20px; }
    .admin-nav {
      display: flex;
      gap: 16px;
      margin-bottom: 30px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
    }
    .admin-nav a {
      text-decoration: none;
      color: #0d1b2a;
      font-weight: 600;
    }
    section { margin-bottom: 40px; }
    .reels-admin { padding-top: 10px; }
    label {
      display: block;
      margin: 14px 0 4px;
      font-weight: 600;
    }
    input[type="text"],
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      box-sizing: border-box;
    }
    input[type="file"] { margin-top: 6px; }
    button {
      background: #c1121f;
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 12px;
    }
    button:hover { background: #a10e19; }
    #reel-status { margin-top: 14px; font-weight: 600; }
    #reel-log {
      margin-top: 8px;
      font-size: 13px;
      color: #555;
      min-height: 20px;
    }
  </style>
</Layout>
