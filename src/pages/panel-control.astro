---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// Verificar sesión antes de mostrar el panel
const cookie = Astro.request.headers.get('cookie') || '';
const tieneSesion = cookie.includes('vb_session=');
if (!tieneSesion) {
  return Astro.redirect('/login');
}
---
<Layout title="Panel de Administración | A Todo Control">
  <div class="admin">
    <h1>Panel de Administración</h1>

    <nav class="admin-nav">
      <a href="#noticias">Noticias</a>
      <a href="#reels">Reels</a>
    </nav>

    <!-- Sección Noticias (placeholder) -->
    <section id="noticias">
      <h2>Publicar Noticia</h2>
      <p>Aquí va tu formulario actual de noticias.</p>
    </section>

    <!-- Sección Reels -->
    <section id="reels" class="reels-admin">
      <h2>Subir Reel</h2>
      <form id="reel-form">
        <label>Título</label>
        <input type="text" name="titulo" required />

        <label>Descripción (opcional)</label>
        <textarea name="descripcion" rows="2"></textarea>

        <label>Video (MP4)</label>
        <input type="file" name="video" accept="video/mp4,video/*" required />

        <label>Foto de portada (para compartir en WhatsApp/Facebook)</label>
        <input type="file" name="imagen" accept="image/*" />

        <button type="submit">Publicar Reel</button>
      </form>
      <div id="reel-status"></div>
    </section>
  </div>

  <script>
    const reelForm = document.getElementById('reel-form');
    const reelStatus = document.getElementById('reel-status');

    if (reelForm) {
      reelForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        reelStatus.textContent = 'Preparando subida...';
        reelStatus.style.color = '#333';

        const titulo = reelForm.querySelector('[name="titulo"]').value;
        const descripcion = reelForm.querySelector('[name="descripcion"]').value || '';
        const videoFile = reelForm.querySelector('[name="video"]').files[0];
        const imagenFile = reelForm.querySelector('[name="imagen"]').files[0];

        if (!titulo || !videoFile) {
          reelStatus.textContent = 'Error: Título y video son obligatorios';
          reelStatus.style.color = 'red';
          return;
        }

        try {
          // 1. Subir video
          reelStatus.textContent = 'Subiendo video...';
          const urlRes = await fetch('/api/reels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'get-upload-url', fileName: videoFile.name })
          });
          const urlData = await urlRes.json();
          if (!urlRes.ok) throw new Error(urlData.error || 'No se pudo obtener URL');

          const uploadRes = await fetch(urlData.signedUrl, {
            method: 'PUT',
            headers: { 'Content-Type': videoFile.type || 'video/mp4' },
            body: videoFile
          });
          if (!uploadRes.ok) throw new Error('Error subiendo el video');

          // 2. Subir imagen de portada si hay
          let imagen_path = null;
          if (imagenFile) {
            reelStatus.textContent = 'Subiendo portada...';
            const imgUrlRes = await fetch('/api/reels', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'get-upload-url', fileName: imagenFile.name })
            });
            const imgUrlData = await imgUrlRes.json();
            if (!imgUrlRes.ok) {
              throw new Error('Error URL portada: ' + (imgUrlData.error || 'desconocido'));
            }
            const imgUpload = await fetch(imgUrlData.signedUrl, {
              method: 'PUT',
              headers: { 'Content-Type': imagenFile.type || 'image/jpeg' },
              body: imagenFile
            });
            if (!imgUpload.ok) {
              throw new Error('Error subiendo portada: ' + imgUpload.status);
            }
            imagen_path = imgUrlData.path;
          }

          // 3. Guardar reel
          reelStatus.textContent = 'Guardando...';
          const saveRes = await fetch('/api/reels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              action: 'save-reel', 
              titulo, 
              descripcion, 
              video_path: urlData.path,
              imagen_path
            })
          });
          const saveData = await saveRes.json();
          if (!saveRes.ok) throw new Error(saveData.error || 'Error guardando');

          reelStatus.textContent = 'Reel publicado correctamente';
          reelStatus.style.color = 'green';
          reelForm.reset();
        } catch (err) {
          reelStatus.textContent = 'Error: ' + err.message;
          reelStatus.style.color = 'red';
        }
      });
    }
  </script>

  <style>
    .admin {
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #fff;
    }
    .admin h1 {
      margin-bottom: 20px;
    }
    .admin-nav {
      display: flex;
      gap: 16px;
      margin-bottom: 30px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
    }
    .admin-nav a {
      text-decoration: none;
      color: #0d1b2a;
      font-weight: 600;
    }
    section {
      margin-bottom: 40px;
    }
    .reels-admin {
      padding-top: 10px;
    }
    label {
      display: block;
      margin: 14px 0 4px;
      font-weight: 600;
    }
    input[type="text"],
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      box-sizing: border-box;
    }
    input[type="file"] {
      margin-top: 6px;
    }
    button {
      background: #c1121f;
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 12px;
    }
    button:hover {
      background: #a10e19;
    }
    #reel-status {
      margin-top: 14px;
      font-weight: 600;
    }
  </style>
</Layout>
