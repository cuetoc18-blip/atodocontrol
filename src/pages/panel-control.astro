---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const cookie = Astro.request.headers.get('cookie') || '';
const tieneSesion = cookie.includes('vb_session=');
if (!tieneSesion) {
  return Astro.redirect('/login');
}
---
<Layout title="Panel de Administración | A Todo Control">
  <div class="admin">
    <h1>Panel de Administración</h1>

    <nav class="admin-nav">
      <a href="#noticias">Noticias</a>
      <a href="#reels">Reels</a>
    </nav>

    <section id="noticias">
      <h2>Publicar Noticia</h2>
      <p>Aquí va tu formulario actual de noticias.</p>
    </section>

    <section id="reels" class="reels-admin">
      <h2>Subir Reel (HLS ya convertido)</h2>
      <form id="reel-form">
        <label>Título</label>
        <input type="text" name="titulo" required />

        <label>Descripción (opcional)</label>
        <textarea name="descripcion" rows="2"></textarea>

        <label>Archivos HLS (index.m3u8 + segmentos .ts)</label>
        <input type="file" name="hls" multiple accept=".m3u8,.ts,application/vnd.apple.mpegurl,video/mp2t" required />

        <label>Foto de portada</label>
        <input type="file" name="imagen" accept="image/*" />

        <button type="submit">Subir y publicar</button>
      </form>
      <div id="reel-status"></div>
      <div id="reel-log"></div>
    </section>
  </div>

  <script type="module">
    const reelForm = document.getElementById('reel-form');
    const reelStatus = document.getElementById('reel-status');
    const reelLog = document.getElementById('reel-log');

    function log(msg) {
      reelLog.textContent = msg;
    }

    async function uploadBlob(path, blob) {
      const urlRes = await fetch('/api/reels', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ action: 'get-upload-url', fileName: path })
      });
      const urlData = await urlRes.json().catch(() => ({}));
      if (!urlRes.ok) throw new Error(urlData.error || 'No se pudo obtener URL (status ' + urlRes.status + ')');
      if (!urlData.signedUrl) throw new Error('No llegó signedUrl: ' + JSON.stringify(urlData));

      const put = await fetch(urlData.signedUrl, {
        method: 'PUT',
        body: blob,
        headers: { 'Content-Type': blob.type || 'application/octet-stream' }
      });
      if (!put.ok) {
        const putText = await put.text().catch(() => '');
        throw new Error('Error subiendo ' + path + ' (status ' + put.status + '): ' + putText.slice(0, 200));
      }
      return urlData.path || path;
    }

    if (reelForm) {
      reelForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        reelStatus.textContent = 'Subiendo...';
        reelStatus.style.color = '#333';
        reelLog.textContent = '';

        const titulo = reelForm.querySelector('[name="titulo"]').value.trim();
        const descripcion = reelForm.querySelector('[name="descripcion"]').value.trim();
        const hlsFiles = Array.from(reelForm.querySelector('[name="hls"]').files);
        const imagenFile = reelForm.querySelector('[name="imagen"]').files[0];

        if (!titulo || hlsFiles.length === 0) {
          reelStatus.textContent = 'Error: Título y archivos HLS son obligatorios';
          reelStatus.style.color = 'red';
          return;
        }

        const m3u8 = hlsFiles.find(f => f.name.endsWith('.m3u8'));
        if (!m3u8) {
          reelStatus.textContent = 'Error: Falta el archivo index.m3u8';
          reelStatus.style.color = 'red';
          return;
        }

        try {
          const folder = `reel-${Date.now()}`;
          log(`Subiendo ${hlsFiles.length} archivos...`);

          const uploads = hlsFiles.map(file => {
            const type = file.name.endsWith('.m3u8')
              ? 'application/vnd.apple.mpegurl'
              : 'video/mp2t';
            const blob = new Blob([file], { type });
            return uploadBlob(`${folder}/${file.name}`, blob);
          });

          await Promise.all(uploads);
          log('Archivos HLS subidos');

          let imagen_path = null;
          if (imagenFile) {
            log('Subiendo portada...');
            imagen_path = await uploadBlob(`${folder}/portada.jpg`, imagenFile);
          }

          log('Guardando reel...');
          const saveRes = await fetch('/api/reels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              action: 'create',
              titulo,
              descripcion,
              hls_path: `${folder}/index.m3u8`,
              imagen_path
            })
          });

          const saveData = await saveRes.json().catch(() => ({}));
          if (!saveRes.ok) throw new Error(saveData.error || 'Error al guardar el reel');

          reelStatus.textContent = 'Reel publicado';
          reelStatus.style.color = 'green';
          reelForm.reset();
          log('');
        } catch (err) {
          reelStatus.textContent = 'Error: ' + err.message;
          reelStatus.style.color = 'red';
          log(err.message);
        }
      });
    }
  </script>

  <style>
    .admin {
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #fff;
    }
    .admin h1 { margin-bottom: 20px; }
    .admin-nav {
      display: flex;
      gap: 16px;
      margin-bottom: 30px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
    }
    .admin-nav a {
      text-decoration: none;
      color: #0d1b2a;
      font-weight: 600;
    }
    section { margin-bottom: 40px; }
    .reels-admin { padding-top: 10px; }
    label {
      display: block;
      margin: 14px 0 4px;
      font-weight: 600;
    }
    input[type="text"],
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      box-sizing: border-box;
    }
    input[type="file"] { margin-top: 6px; }
    button {
      background: #c1121f;
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 12px;
    }
    button:hover { background: #a10e19; }
    #reel-status { margin-top: 14px; font-weight: 600; }
    #reel-log {
      margin-top: 8px;
      font-size: 13px;
      color: #555;
      min-height: 20px;
    }
  </style>
</Layout>
