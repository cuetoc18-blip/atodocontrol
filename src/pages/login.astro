---
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesión | A Todo Control</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f3f4f6; margin: 0; padding: 20px; }
    .card { max-width: 400px; margin: 40px auto; background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    h1 { text-align: center; margin: 0 0 24px; font-size: 24px; }
    label { display: block; margin: 12px 0 6px; font-weight: 500; }
    input, select { width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 16px; box-sizing: border-box; }
    button { width: 100%; margin-top: 20px; padding: 14px; background: #b91c1c; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; }
    .link { text-align: center; margin-top: 16px; font-size: 14px; }
    .link a { color: #b91c1c; font-weight: 600; cursor: pointer; }
    .error { color: #b91c1c; text-align: center; margin-top: 12px; font-size: 14px; }
    .hidden { display: none; }
    #preview { width: 80px; height: 80px; border-radius: 50%; margin: 0 auto 12px; display: block; background: #e5e7eb; }
  </style>
</head>
<body>
  <div class="card">
    <h1 id="titulo">Iniciar sesión</h1>
    <img id="preview" alt="Avatar" style="display:none;">
    <form id="form">
      <div id="extra" class="hidden">
        <label>Nombre</label>
        <input type="text" id="nombre" oninput="actualizarPreview()">
        <label>Género</label>
        <select id="genero" onchange="actualizarPreview()">
          <option value="m">Hombre</option>
          <option value="f">Mujer</option>
        </select>
      </div>
      <label>Correo</label>
      <input type="email" id="email" required>
      <label>Contraseña</label>
      <input type="password" id="password" required>
      <button type="submit" id="btn">Entrar</button>
    </form>
    <div id="error" class="error"></div>
    <div class="link" id="switch">¿No tienes cuenta? <a onclick="toggle()">Crear cuenta</a></div>
  </div>
  <script>
    let modo = 'login';
    function actualizarPreview() {
      if (modo !== 'registro') return;
      const nombre = document.getElementById('nombre').value || 'Usuario';
      const genero = document.getElementById('genero').value;
      const estilo = genero === 'f' ? 'lorelei' : 'adventurer';
      const url = `https://api.dicebear.com/7.x/${estilo}/svg?seed=${encodeURIComponent(nombre)}&backgroundColor=b6e3f4,c0aede,d1d4f9`;
      const img = document.getElementById('preview');
      img.src = url;
      img.style.display = 'block';
    }
    window.toggle = function() {
      modo = modo === 'login' ? 'registro' : 'login';
      document.getElementById('titulo').textContent = modo === 'login' ? 'Iniciar sesión' : 'Crear cuenta';
      document.getElementById('btn').textContent = modo === 'login' ? 'Entrar' : 'Crear cuenta';
      document.getElementById('extra').classList.toggle('hidden', modo === 'login');
      document.getElementById('preview').style.display = modo === 'registro' ? 'block' : 'none';
      document.getElementById('switch').innerHTML = modo === 'login'
        ? '¿No tienes cuenta? <a onclick="toggle()">Crear cuenta</a>'
        : '¿Ya tienes cuenta? <a onclick="toggle()">Iniciar sesión</a>';
      document.getElementById('error').textContent = '';
      if (modo === 'registro') actualizarPreview();
    };
    document.getElementById('form').onsubmit = async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const nombre = document.getElementById('nombre').value;
      const genero = document.getElementById('genero').value;
      const url = modo === 'login' ? '/api/auth/login-usuario' : '/api/auth/registro';
      const body = modo === 'login' ? { email, password } : { email, password, nombre, genero };
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (!res.ok) {
        document.getElementById('error').textContent = data.error || 'Error';
        return;
      }
      location.href = '/';
    };
  </script>
</body>
</html>
