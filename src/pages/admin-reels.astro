---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---
<Layout title="Panel Admin | A Todo Control">
  <div class="admin">
    <h1>Panel de Administración</h1>

    <section class="reels-admin">
      <h2>Subir Reel</h2>
      <form id="reel-form">
        <label>Título</label>
        <input type="text" name="titulo" required />

        <label>Descripción (opcional)</label>
        <textarea name="descripcion" rows="2"></textarea>

        <label>Video (MP4)</label>
        <input type="file" name="video" accept="video/mp4,video/*" required />

        <button type="submit">Publicar Reel</button>
      </form>
      <div id="reel-status"></div>
    </section>
  </div>

  <script>
    const form = document.getElementById('reel-form');
    const status = document.getElementById('reel-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Preparando...';

      const formData = new FormData(form);
      const titulo = formData.get('titulo');
      const descripcion = formData.get('descripcion') || '';
      const videoFile = formData.get('video');

      if (!titulo || !videoFile || videoFile.size === 0) {
        status.textContent = 'Error: Título y video son obligatorios';
        return;
      }

      if (videoFile.size > 45 * 1024 * 1024) {
        status.textContent = 'Error: El video es muy grande. Máximo 45 MB';
        return;
      }

      try {
        status.textContent = 'Subiendo video...';
        
        // Subir directo a Supabase Storage (sin pasar por Netlify)
        const fileName = `${Date.now()}-${videoFile.name.replace(/\s/g, '_')}`;
        const uploadRes = await fetch(`https://hlqdkosclnmmdhasoupt.supabase.co/storage/v1/object/reels-videos/${fileName}`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
            'Content-Type': videoFile.type || 'video/mp4',
            'x-upsert': 'false'
          },
          body: videoFile
        });

        if (!uploadRes.ok) {
          const err = await uploadRes.text();
          throw new Error('Error subiendo a storage: ' + err);
        }

        status.textContent = 'Guardando reel...';
        
        // Registrar en la tabla via API
        const saveRes = await fetch('/api/reels', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            titulo,
            descripcion,
            video_url: `https://hlqdkosclnmmdhasoupt.supabase.co/storage/v1/object/public/reels-videos/${fileName}`,
            video_path: fileName
          })
        });

        const data = await saveRes.json();
        if (!saveRes.ok) throw new Error(data.error || 'Error guardando');

        status.textContent = 'Reel publicado correctamente';
        form.reset();
      } catch (err) {
        status.textContent = 'Error: ' + err.message;
      }
    });
  </script>

  <style>
    .admin { max-width: 700px; margin: 40px auto; padding: 20px; }
    .reels-admin { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; }
    label { display: block; margin: 12px 0 4px; font-weight: 600; }
    input, textarea { width: 100%; padding: 8px; margin-bottom: 8px; }
    button { background: #c1121f; color: white; border: none; padding: 10px 16px; cursor: pointer; }
    #reel-status { margin-top: 12px; font-weight: 600; }
  </style>
</Layout>
