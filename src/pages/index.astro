---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

export const prerender = false;

const cat = Astro.url.searchParams.get('cat') || '';
const client = supabase();
let q = client
  .from('noticias')
  .select('id,titulo,resumen,categoria,imagen_url,instagram_url,publicada,es_portada,fecha_publicacion,created_at')
  .eq('publicada', true)
  .order('fecha_publicacion', { ascending: false })
  .limit(16);
if (cat) q = q.eq('categoria', cat);
const { data: rows } = await q;
const list = rows || [];
const featured = list.find(n => n.es_portada) || list[0];
const rest = list.filter(n => n.id !== featured?.id);

function hace(d) {
  const ms = Date.now() - new Date(d).getTime();
  const m = Math.max(0, Math.floor(ms / 60000));
  if (m < 1) return 'Hace un momento';
  if (m < 60) return `Hace ${m} min`;
  const h = Math.floor(m / 60);
  if (h < 24) return h === 1 ? 'Hace 1 hora' : `Hace ${h} horas`;
  const days = Math.floor(h / 24);
  return days === 1 ? 'Hace 1 día' : `Hace ${days} días`;
}
function foto(n) {
  const u = n?.imagen_url || '';
  if (!u || /(instagram|facebook|twitter|x)\.com/i.test(u)) return '';
  const m = u.match(/\/noticias-imagenes\/(.+)$/);
  return m ? '/media/' + m[1] : u;
}
---
<Layout title="A Todo Control | Veeduría ciudadana y control político" description="Medio de veeduría ciudadana y control político." url="https://atodocontrol.co/">
  <div class="feed">
    {featured && (
      <a class="hero" href={`/noticia/${featured.id}`}>
        <div class="hero-txt">
          <div class="meta">
            <span class="sec">{featured.categoria || 'General'}</span>
            <span class="time">{hace(featured.fecha_publicacion || featured.created_at)}</span>
          </div>
          <h1>{featured.titulo}</h1>
          {featured.resumen && <p class="lead">{featured.resumen}</p>}
        </div>
        {foto(featured) ? (
          <img src={foto(featured)} alt={featured.titulo} />
        ) : (
          <div class="ph">▶</div>
        )}
      </a>
    )}

    {!featured && <p class="empty">Aún no hay noticias publicadas.</p>}

    <div class="lista">
      {rest.map(n => (
        <a class="row" href={`/noticia/${n.id}`}>
          {foto(n) ? (
            <img class="thumb" src={foto(n)} alt="" />
          ) : (
            <div class="thumb ph">▶</div>
          )}
          <div class="row-txt">
            <div class="meta">
              <span class="sec">{n.categoria || 'General'}</span>
              <span class="time">{hace(n.fecha_publicacion || n.created_at)}</span>
            </div>
            <h2>{n.titulo}</h2>
          </div>
        </a>
      ))}
    </div>

    <!-- SECCIÓN DE REELS -->
    <section class="reels-section">
      <h2 class="reels-title">Opinión en formato vertical</h2>
      <p class="reels-subtitle">Reels</p>
      <div id="reels-contenedor" class="reels-container"></div>
    </section>
  </div>

  <script>
    async function cargarReels() {
      const contenedor = document.getElementById('reels-contenedor');
      if (!contenedor) return;

      try {
        const res = await fetch('/api/reels');
        const reels = await res.json();

        if (!reels.length) {
          contenedor.innerHTML = '<p style="color:#64748b;text-align:center;padding:20px 0;">No hay reels</p>';
          return;
        }

        let html = '';
        for (const reel of reels) {
          const videoUrl = reel.video_url || '';
          if (!videoUrl) continue;
          html += `
            <div class="reel-item" data-id="${reel.id}" data-src="${videoUrl}">
              <div class="reel-thumb">
                <video src="${videoUrl}" muted playsinline loop preload="auto" autoplay></video>
                <div class="reel-play">▶</div>
              </div>
              <p class="reel-title">${reel.titulo || ''}</p>
            </div>
          `;
        }
        contenedor.innerHTML = html;
        contenedor.querySelectorAll('.reel-item').forEach(item => {
          const v = item.querySelector('video');
          if (v) {
            v.play().catch(() => {});
          }
          item.addEventListener('click', () => {
            const reelId = item.dataset.id;
            if (reelId) window.location.href = '/reel/' + reelId;
          });
        });
      } catch (e) {
        contenedor.innerHTML = '<p style="color:#64748b;text-align:center;padding:20px 0;">Error cargando reels</p>';
      }
    }

    function abrirReels(lista, srcInicial) {
      let idx = lista.findIndex(r => r.video_url === srcInicial);
      if (idx < 0) idx = 0;

      const overlay = document.createElement('div');
      overlay.id = 'reel-overlay';
      overlay.innerHTML = `
        <div class="reel-visor">
          <video id="reel-video" playsinline loop autoplay preload="auto"></video>
          <div class="reel-bottom">
            <div class="reel-info">
              <a href="/" class="reel-logo-link">
                <img src="/logo2.png" alt="A Todo Control" class="reel-logo" />
              </a>
              <div class="reel-nombre">A Todo Control</div>
            </div>
            <div class="reel-texto">
              <div class="reel-titulo" id="reel-titulo"></div>
              <div class="reel-desc" id="reel-desc"></div>
              <span class="reel-vermas" id="reel-vermas" style="display:none;">Ver más</span>
            </div>
          </div>
          <div class="reel-acciones">
            <button class="reel-like" id="reel-like">♡ <span id="like-count">0</span></button>
            <button class="reel-share" id="reel-share">↗</button>
          </div>
          <button class="reel-cerrar">✕</button>
        </div>
      `;
      document.body.appendChild(overlay);

      const video = overlay.querySelector('#reel-video');
      const tituloEl = overlay.querySelector('#reel-titulo');
      const descEl = overlay.querySelector('#reel-desc');
      const verMas = overlay.querySelector('#reel-vermas');

      function mostrar(i) {
        if (i < 0 || i >= lista.length) return;
        idx = i;
        const r = lista[idx];
        video.src = r.video_url;
        video.muted = false;
        video.play().catch(() => {
          video.muted = true;
          video.play();
        });
        tituloEl.textContent = r.titulo || '';
        const desc = r.descripcion || '';
        if (desc.length > 100) {
          descEl.textContent = desc.slice(0, 100) + '...';
          verMas.style.display = 'inline';
          verMas.onclick = () => { descEl.textContent = desc; verMas.style.display = 'none'; };
        } else {
          descEl.textContent = desc;
          verMas.style.display = 'none';
        }
        cargarLikesOverlay(r.id);
      }
      mostrar(idx);

      overlay.querySelector('.reel-cerrar').onclick = () => overlay.remove();

      const likeBtn = overlay.querySelector('#reel-like');
      likeBtn.onclick = async () => {
        const r = lista[idx];
        if (!r) return;
        const res = await fetch('/api/reels-like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reel_id: r.id })
        });
        const data = await res.json();
        if (data.liked) {
          likeBtn.innerHTML = '♥ <span id="like-count">' + data.likes + '</span>';
          likeBtn.style.color = '#ff2d55';
        } else {
          likeBtn.innerHTML = '♡ <span id="like-count">' + data.likes + '</span>';
          likeBtn.style.color = '#fff';
        }
      };

      async function cargarLikesOverlay(reelId) {
        const res = await fetch('/api/reels-like?reel_id=' + reelId);
        const data = await res.json();
        if (data.liked) {
          likeBtn.innerHTML = '♥ <span id="like-count">' + data.likes + '</span>';
          likeBtn.style.color = '#ff2d55';
        } else {
          likeBtn.innerHTML = '♡ <span id="like-count">' + data.likes + '</span>';
          likeBtn.style.color = '#fff';
        }
      }

      overlay.querySelector('#reel-share').onclick = () => {
        const r = lista[idx];
        const url = window.location.origin + '/reel/' + (r.id || idx);
        const texto = (r.titulo || '') + (r.descripcion ? '\n' + r.descripcion : '');
        if (navigator.share) {
          navigator.share({ title: r.titulo || 'Reel', text: texto, url }).catch(()=>{});
        } else {
          navigator.clipboard.writeText(texto + '\n' + url);
          alert('Enlace copiado');
        }
      };

      let startY = 0;
      overlay.addEventListener('touchstart', e => { 
        if (e.target.closest('.reel-logo-link')) return;
        startY = e.touches[0].clientY; 
      }, {passive: true});
      overlay.addEventListener('touchend', e => {
        if (e.target.closest('.reel-logo-link')) return;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dy) > 40) {
          if (dy < 0) mostrar(idx + 1);
          else mostrar(idx - 1);
        }
      }, {passive: true});

      overlay.addEventListener('mousedown', e => { startY = e.clientY; });
      overlay.addEventListener('mouseup', e => {
        const dy = e.clientY - startY;
        if (Math.abs(dy) > 40) {
          if (dy < 0) mostrar(idx + 1);
          else mostrar(idx - 1);
        }
      });
    }

    cargarReels();
  </script>

  <style>
    .feed { background: #fff; max-width: 1100px; margin: 0 auto; padding: 20px 24px 40px; }
    .hero, .row { display: block; text-decoration: none; color: inherit; }
    .meta { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
    .sec { color: #c1121f; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .time { color: #94a3b8; font-size: .78rem; }
    .hero h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.55rem;
      line-height: 1.18;
      font-weight: 800;
      margin: 0 0 10px;
      color: #111;
    }
    .lead { color: #475569; font-size: .98rem; line-height: 1.45; margin: 0 0 14px; }
    .hero img, .hero .ph {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: center 35%;
      display: block;
      background: #e2e8f0;
      border-radius: 6px;
    }
    .hero { padding-bottom: 18px; border-bottom: 1px solid #e5e7eb; margin-bottom: 4px; }
    .lista { background: #fff; }
    .row {
      display: flex;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid #eee;
      align-items: flex-start;
    }
    .thumb {
      width: 92px;
      height: 92px;
      object-fit: cover;
      flex-shrink: 0;
      background: #e2e8f0;
    }
    .row-txt h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.02rem;
      line-height: 1.25;
      font-weight: 700;
      margin: 0;
      color: #111;
    }
    .ph { display: flex; align-items: center; justify-content: center; background: #0d1b2a; color: #fff; font-size: 1.2rem; }
    .empty { color: #64748b; padding: 24px 0; }

    /* Estilos Reels - :global para que apliquen a elementos dinámicos */
    :global(.reels-section) {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid #e5e7eb;
    }
    :global(.reels-title) {
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0 0 4px;
    }
    :global(.reels-subtitle) {
      font-family: Georgia, serif;
      font-size: 1.8rem;
      font-weight: 800;
      margin: 0 0 16px;
      color: #111;
    }
    :global(.reels-container) {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 8px 0 16px;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
    }
    :global(#reel-overlay) {
      position: fixed;
      inset: 0;
      background: #000;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    :global(.reel-visor) {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media (min-width: 700px) {
      :global(.reel-visor) {
        max-width: 380px;
        height: 85vh;
        aspect-ratio: 9/16;
      }
    }
    :global(#reel-video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    :global(.reel-bottom) {
      position: absolute;
      bottom: 16px;
      left: 12px;
      right: 56px;
      color: #fff;
      z-index: 5;
    }
    :global(.reel-info) {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    :global(.reel-logo-link) {
      display: block;
      line-height: 0;
      z-index: 20;
      pointer-events: auto;
    }
    :global(.reel-logo) {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      background: transparent;
      border: none;
    }
    :global(.reel-nombre) {
      font-weight: 700;
      font-size: .9rem;
      text-shadow: 0 1px 3px rgba(0,0,0,.6);
    }
    :global(.reel-texto) {
      text-shadow: 0 1px 3px rgba(0,0,0,.7);
    }
    :global(.reel-acciones) {
      position: absolute;
      right: 8px;
      bottom: 120px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      z-index: 2;
    }
    :global(.reel-like), :global(.reel-share) {
      background: none;
      border: none;
      color: #fff;
      font-size: 26px;
      cursor: pointer;
      text-shadow: 0 1px 4px rgba(0,0,0,.5);
      padding: 0;
    }
    :global(.reel-titulo) {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 4px;
      line-height: 1.3;
    }
    :global(.reel-desc) {
      font-size: .88rem;
      line-height: 1.4;
      opacity: .95;
    }
    :global(.reel-vermas) {
      color: #fff;
      font-weight: 700;
      font-size: .85rem;
      cursor: pointer;
    }
    :global(.reel-cerrar) {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(0,0,0,.5);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      font-size: 18px;
      cursor: pointer;
    }
    :global(.reel-item) {
      flex: 0 0 140px !important;
      width: 140px !important;
      min-width: 140px !important;
      max-width: 140px !important;
      scroll-snap-align: start;
    }
    :global(.reel-thumb) {
      width: 140px;
      height: 249px;
      background: #111;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
    }
    :global(.reel-thumb video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      top: 0;
      left: 0;
    }
    :global(.reel-play) {
      position: absolute;
      width: 40px;
      height: 40px;
      background: rgba(0,0,0,.6);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 16px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    :global(.reel-title) {
      margin: 10px 0 0;
      font-size: 0.95rem;
      font-weight: 700 !important;
      color: #111;
      line-height: 1.35;
    }

    @media (min-width: 900px) {
      .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: center; }
      .hero h1 { font-size: 2.35rem; margin-bottom: 12px; }
      .lead { font-size: 1.05rem; }
      .hero img, .hero .ph { height: 340px; border-radius: 8px; }
      .thumb { width: 140px; height: 100px; }
      .row-txt h2 { font-size: 1.15rem; }
    }
  </style>
</Layout>
