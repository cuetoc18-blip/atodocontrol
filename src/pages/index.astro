---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

const client = supabase();
const { data: noticias } = await client
  .from('noticias')
  .select('*')
  .order('fecha_publicacion', { ascending: false })
  .limit(30);
---
<Layout title="A Todo Control | Veeduría ciudadana y control político">
  <div class="home">
    <!-- Noticias -->
    <div class="news-list">
      {noticias?.map((n) => (
        <a href={`/noticia/${n.id}`} class="news-card">
          {n.imagen_url && (
            <img src={n.imagen_url.replace(/.*\/noticias-imagenes\//, '/media/')} alt="" />
          )}
          <div class="news-info">
            <span class="cat">{n.categoria || 'General'}</span>
            <h2>{n.titulo}</h2>
            <p>{n.resumen}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Reels -->
    <section class="reels-section">
      <h2>Reels</h2>
      <div id="reels-contenedor" class="reels-scroll"></div>
    </section>
  </div>

  <script>
    async function cargarReels() {
      const contenedor = document.getElementById('reels-contenedor');
      if (!contenedor) return;

      try {
        const res = await fetch('/api/reels');
        const reels = await res.json();

        if (!reels.length) {
          contenedor.innerHTML = '<p class="empty">No hay reels</p>';
          return;
        }

        let html = '';
        for (const reel of reels) {
          const videoUrl = `/media/${reel.video_path}`;
          html += `
            <div class="reel-item">
              <div class="reel-video-wrap">
                <video src="${videoUrl}" controls playsinline preload="metadata"></video>
              </div>
              <p class="reel-title">${reel.titulo || ''}</p>
            </div>
          `;
        }
        contenedor.innerHTML = html;
      } catch (e) {
        contenedor.innerHTML = '<p class="error">Error cargando reels</p>';
      }
    }
    cargarReels();
  </script>
</Layout>

<style>
  .home { max-width: 1100px; margin: 0 auto; padding: 16px; }
  .news-list { display: grid; gap: 16px; }
  .news-card { display: flex; gap: 12px; text-decoration: none; color: inherit; background: #1a1a1a; border-radius: 12px; overflow: hidden; }
  .news-card img { width: 140px; height: 100px; object-fit: cover; }
  .news-info { padding: 12px; }
  .news-info .cat { font-size: 12px; color: #e11d48; font-weight: 600; }
  .news-info h2 { margin: 4px 0; font-size: 16px; }
  .news-info p { margin: 0; font-size: 13px; color: #aaa; }

  .reels-section { margin-top: 40px; }
  .reels-section h2 { color: #fff; font-size: 20px; margin-bottom: 16px; }
  .reels-scroll { 
    display: flex; 
    gap: 16px; 
    overflow-x: auto; 
    scroll-snap-type: x mandatory; 
    padding-bottom: 16px;
    -webkit-overflow-scrolling: touch;
  }
  .reel-item { 
    flex: 0 0 200px; 
    scroll-snap-align: start; 
  }
  .reel-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9/16;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
  }
  .reel-video-wrap video { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
  }
  .reel-title { 
    margin: 8px 0 0; 
    font-size: 13px; 
    font-weight: 600; 
    color: #fff; 
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .empty, .error { color: #888; text-align: center; }
</style>
