---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

export const prerender = false;

const cat = Astro.url.searchParams.get('cat') || '';
const client = supabase();
let q = client
  .from('noticias')
  .select('id,titulo,resumen,categoria,imagen_url,instagram_url,publicada,es_portada,fecha_publicacion,created_at')
  .eq('publicada', true)
  .order('fecha_publicacion', { ascending: false })
  .limit(16);
if (cat) q = q.eq('categoria', cat);
const { data: rows } = await q;
const list = rows || [];
const featured = list.find(n => n.es_portada) || list[0];
const rest = list.filter(n => n.id !== featured?.id);

// Traer reels
let reels = [];
try {
  const res = await fetch(new URL('/api/reels', Astro.url.origin));
  if (res.ok) reels = await res.json();
} catch (e) {
  console.error('Error cargando reels', e);
}

function hace(d) {
  const ms = Date.now() - new Date(d).getTime();
  const m = Math.max(0, Math.floor(ms / 60000));
  if (m < 1) return 'Hace un momento';
  if (m < 60) return `Hace ${m} min`;
  const h = Math.floor(m / 60);
  if (h < 24) return h === 1 ? 'Hace 1 hora' : `Hace ${h} horas`;
  const days = Math.floor(h / 24);
  return days === 1 ? 'Hace 1 día' : `Hace ${days} días`;
}
function foto(n) {
  const u = n?.imagen_url || '';
  if (!u || /(instagram|facebook|twitter|x)\.com/i.test(u)) return '';
  const m = u.match(/\/noticias-imagenes\/(.+)$/);
  return m ? '/media/' + m[1] : u;
}

function getEmbedUrl(url) {
  if (!url) return '';
  if (url.includes('instagram.com/reel/') || url.includes('instagram.com/p/')) {
    return url.replace(/\/$/, '') + '/embed/';
  }
  if (url.includes('facebook.com')) {
    return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=200`;
  }
  return '';
}
---
<Layout title="A Todo Control | Veeduría ciudadana y control político" description="Medio de veeduría ciudadana y control político." url="https://atodocontrol.co/">
  <div class="feed">
    {featured && (
      <a class="hero" href={`/noticia/${featured.id}`}>
        <div class="hero-txt">
          <div class="meta">
            <span class="sec">{featured.categoria || 'General'}</span>
            <span class="time">{hace(featured.fecha_publicacion || featured.created_at)}</span>
          </div>
          <h1>{featured.titulo}</h1>
          {featured.resumen && <p class="lead">{featured.resumen}</p>}
        </div>
        {foto(featured) ? (
          <img src={foto(featured)} alt={featured.titulo} />
        ) : (
          <div class="ph">▶</div>
        )}
      </a>
    )}

    {!featured && <p class="empty">Aún no hay noticias publicadas.</p>}

    <div class="lista">
      {rest.map(n => (
        <a class="row" href={`/noticia/${n.id}`}>
          {foto(n) ? (
            <img class="thumb" src={foto(n)} alt="" />
          ) : (
            <div class="thumb ph">▶</div>
          )}
          <div class="row-txt">
            <div class="meta">
              <span class="sec">{n.categoria || 'General'}</span>
              <span class="time">{hace(n.fecha_publicacion || n.created_at)}</span>
            </div>
            <h2>{n.titulo}</h2>
          </div>
        </a>
      ))}
    </div>

    {reels.length > 0 && (
      <section class="reels-section">
        <h2 class="reels-title">Opinión en formato vertical</h2>
        <p class="reels-subtitle">Reels</p>
        <div class="reels-container">
          {reels.map(reel => {
            const embedUrl = getEmbedUrl(reel.url);
            return (
              <div class="reel-card">
                <div class="reel-thumb">
                  {embedUrl ? (
                    <div class="iframe-wrapper">
                      <iframe
                        src={embedUrl}
                        width="200"
                        height="320"
                        frameborder="0"
                        scrolling="no"
                        allowtransparency="true"
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                      ></iframe>
                    </div>
                  ) : reel.imagen_url ? (
                    <a href={reel.url} target="_blank" rel="noopener">
                      <img src={reel.imagen_url} alt={reel.titulo} />
                    </a>
                  ) : (
                    <a href={reel.url} target="_blank" rel="noopener" class="reel-placeholder">
                      <span class="play">▶</span>
                    </a>
                  )}
                </div>
                <div class="reel-title">{reel.titulo}</div>
              </div>
            );
          })}
        </div>
      </section>
    )}
  </div>

  <style>
    .feed { background: #fff; max-width: 1100px; margin: 0 auto; padding: 20px 24px 40px; }
    .hero, .row { display: block; text-decoration: none; color: inherit; }
    .meta { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
    .sec { color: #c1121f; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .time { color: #94a3b8; font-size: .78rem; }
    .hero h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.55rem;
      line-height: 1.18;
      font-weight: 800;
      margin: 0 0 10px;
      color: #111;
    }
    .lead { color: #475569; font-size: .98rem; line-height: 1.45; margin: 0 0 14px; }
    .hero img, .hero .ph {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: center 35%;
      display: block;
      background: #e2e8f0;
      border-radius: 6px;
    }
    .hero { padding-bottom: 18px; border-bottom: 1px solid #e5e7eb; margin-bottom: 4px; }
    .lista { background: #fff; }
    .row {
      display: flex;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid #eee;
      align-items: flex-start;
    }
    .thumb {
      width: 92px;
      height: 92px;
      object-fit: cover;
      flex-shrink: 0;
      background: #e2e8f0;
    }
    .row-txt h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.02rem;
      line-height: 1.25;
      font-weight: 700;
      margin: 0;
      color: #111;
    }
    .ph { display: flex; align-items: center; justify-content: center; background: #0d1b2a; color: #fff; font-size: 1.2rem; }
    .empty { color: #64748b; padding: 24px 0; }

    .reels-section {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid #e5e7eb;
    }
    .reels-title {
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0 0 4px;
    }
    .reels-subtitle {
      font-family: Georgia, serif;
      font-size: 1.8rem;
      font-weight: 800;
      margin: 0 0 16px;
      color: #111;
    }
    .reels-container {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding-bottom: 10px;
    }
    .reel-card {
      flex: 0 0 200px;
      text-decoration: none;
      color: inherit;
    }
    .reel-thumb {
      width: 200px;
      height: 320px;
      border-radius: 14px;
      overflow: hidden;
      background: #0d1b2a;
      position: relative;
    }
    .iframe-wrapper {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
    }
    .iframe-wrapper iframe {
      width: 100%;
      height: 380px;
      border: none;
      display: block;
      position: absolute;
      top: -50px;
      left: 0;
    }
    .reel-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .reel-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .play {
      width: 52px;
      height: 52px;
      background: rgba(255,255,255,0.9);
      color: #0d1b2a;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      font-weight: bold;
    }
    .reel-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-top: 8px;
      line-height: 1.3;
      color: #111;
    }

    @media (min-width: 900px) {
      .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: center; }
      .hero h1 { font-size: 2.35rem; margin-bottom: 12px; }
      .lead { font-size: 1.05rem; }
      .hero img, .hero .ph { height: 340px; border-radius: 8px; }
      .thumb { width: 140px; height: 100px; }
      .row-txt h2 { font-size: 1.15rem; }
    }
  </style>
</Layout>
