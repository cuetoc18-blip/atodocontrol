---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase.js';

export const prerender = false;

const cat = Astro.url.searchParams.get('cat') || '';
const client = supabase();
let q = client
  .from('noticias')
  .select('id,titulo,resumen,categoria,imagen_url,instagram_url,publicada,es_portada,fecha_publicacion,created_at')
  .eq('publicada', true)
  .order('fecha_publicacion', { ascending: false })
  .limit(20);
if (cat) q = q.eq('categoria', cat);
const { data: rows } = await q;
const list = rows || [];

function hace(d) {
  const ms = Date.now() - new Date(d).getTime();
  const m = Math.max(0, Math.floor(ms / 60000));
  if (m < 1) return 'Hace un momento';
  if (m < 60) return `Hace ${m} min`;
  const h = Math.floor(m / 60);
  if (h < 24) return h === 1 ? 'Hace 1 hora' : `Hace ${h} horas`;
  const days = Math.floor(h / 24);
  return days === 1 ? 'Hace 1 día' : `Hace ${days} días`;
}
function foto(n) {
  const u = n?.imagen_url || '';
  if (!u || /(instagram|facebook|twitter|x)\.com/i.test(u)) return '';
  const m = u.match(/\/noticias-imagenes\/(.+)$/);
  return m ? '/media/' + m[1] : u;
}
---
<Layout title="Noticias | A Todo Control" description="Listado de noticias">
  <div class="feed">
    <h1>Noticias</h1>
    <div class="lista">
      {list.map(n => (
        <a class="row" href={`/noticia/${n.id}`}>
          {foto(n) ? (
            <img class="thumb" src={foto(n)} alt="" />
          ) : (
            <div class="thumb ph">▶</div>
          )}
          <div class="row-txt">
            <div class="meta">
              <span class="sec">{n.categoria || 'General'}</span>
              <span class="time">{hace(n.fecha_publicacion || n.created_at)}</span>
            </div>
            <h2>{n.titulo}</h2>
          </div>
        </a>
      ))}
    </div>
    {!list.length && <p class="empty">No hay noticias.</p>}
  </div>

  <style>
    .feed { max-width: 800px; margin: 0 auto; padding: 20px; }
    h1 { margin-bottom: 20px; }
    .row { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid #eee; text-decoration: none; color: inherit; }
    .thumb { width: 100px; height: 80px; object-fit: cover; background: #e2e8f0; }
    .ph { display: flex; align-items: center; justify-content: center; background: #0d1b2a; color: #fff; }
    .row-txt h2 { font-size: 1.05rem; margin: 0; }
    .meta { font-size: 0.8rem; color: #64748b; margin-bottom: 4px; }
    .sec { color: #c1121f; font-weight: 700; }
    .empty { color: #64748b; }
  </style>
</Layout>
