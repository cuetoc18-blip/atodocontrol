---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;
---
<Layout title="Reel | A Todo Control">
  <div id="reel-page">
    <div class="reel-box">
      <video id="reel-video" playsinline loop autoplay preload="auto"></video>
      <div class="reel-info">
        <img src="/logo2.png" alt="A Todo Control" class="reel-logo" />
        <div class="reel-nombre">A Todo Control</div>
      </div>
      <div class="reel-texto">
        <div class="reel-titulo" id="reel-titulo"></div>
        <div class="reel-desc" id="reel-desc"></div>
      </div>
      <div class="reel-acciones">
        <button class="reel-like" id="reel-like">♡</button>
        <button class="reel-share" id="reel-share">↗</button>
      </div>
      <a href="/" class="reel-cerrar">✕</a>
    </div>
  </div>

  <script define:vars={{ id }}>
    let reels = [];
    let idx = 0;

    async function cargar() {
      const res = await fetch('/api/reels');
      reels = await res.json();
      idx = reels.findIndex(x => x.id === id);
      if (idx < 0) idx = 0;
      mostrar(idx);
    }

    function mostrar(i) {
      if (i < 0 || i >= reels.length) return;
      idx = i;
      const r = reels[idx];
      history.replaceState(null, '', '/reel/' + r.id);

      const video = document.getElementById('reel-video');
      video.src = r.video_url;
      video.play().catch(()=>{});

      document.getElementById('reel-titulo').textContent = r.titulo || '';
      document.getElementById('reel-desc').textContent = r.descripcion || '';
    }

    document.getElementById('reel-like').onclick = (e) => {
      e.target.textContent = e.target.textContent === '♡' ? '♥' : '♡';
      e.target.style.color = e.target.textContent === '♥' ? '#ff2d55' : '#fff';
    };

    document.getElementById('reel-share').onclick = () => {
      const r = reels[idx];
      const url = window.location.origin + '/reel/' + r.id;
      if (navigator.share) {
        navigator.share({ title: r.titulo || 'Reel', url }).catch(()=>{});
      } else {
        navigator.clipboard.writeText(url);
        alert('Enlace copiado');
      }
    };

    let startY = 0;
    document.getElementById('reel-page').addEventListener('touchstart', e => { startY = e.touches[0].clientY; }, {passive:true});
    document.getElementById('reel-page').addEventListener('touchend', e => {
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dy) > 50) {
        if (dy < 0) mostrar(idx + 1);
        else mostrar(idx - 1);
      }
    }, {passive:true});

    cargar();
  </script>

  <style>
    #reel-page {
      position: fixed;
      inset: 0;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .reel-box {
      position: relative;
      height: 100%;
      max-width: 420px;
      width: 100%;
    }
    @media (min-width: 700px) {
      .reel-box {
        width: auto;
        height: 100vh;
        aspect-ratio: 9/16;
        max-width: none;
      }
    }
    #reel-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .reel-info {
      position: absolute;
      bottom: 90px;
      left: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #fff;
    }
    .reel-logo {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      background: #fff;
      border: 2px solid #fff;
    }
    .reel-nombre {
      font-weight: 700;
      font-size: .9rem;
      text-shadow: 0 1px 3px rgba(0,0,0,.6);
    }
    .reel-texto {
      position: absolute;
      bottom: 16px;
      left: 12px;
      right: 50px;
      color: #fff;
      text-shadow: 0 1px 3px rgba(0,0,0,.7);
    }
    .reel-titulo { font-weight: 700; margin-bottom: 4px; font-size: .95rem; }
    .reel-desc { font-size: .85rem; opacity: .95; }
    .reel-acciones {
      position: absolute;
      right: 8px;
      bottom: 110px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .reel-like, .reel-share {
      background: none;
      border: none;
      color: #fff;
      font-size: 26px;
      cursor: pointer;
      text-shadow: 0 1px 4px rgba(0,0,0,.5);
    }
    .reel-cerrar {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(0,0,0,.5);
      color: #fff;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 16px;
    }
  </style>
</Layout>
