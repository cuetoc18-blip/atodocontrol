---
import Layout from '../../layouts/Layout.astro';
import ReelPlayer from '../../components/ReelPlayer.svelte';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const { id } = Astro.params;

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

let reel = null;
if (id) {
  const { data } = await supabase.from('reels').select('*').eq('id', id).maybeSingle();
  reel = data;
}

const titulo = reel?.titulo || 'Reel | A Todo Control';
const descripcion = reel?.descripcion || 'Mira este reel en A Todo Control';
const imagen = reel?.imagen_url || 'https://atodocontrol.co/logo2.png';
const url = `https://atodocontrol.co/reel/${id}`;
---
<Layout title={titulo} description={descripcion} image={imagen} url={url}>
  <style is:inline>
    body { margin: 0; background: #000; }
    header, footer, .footer { display: none !important; }
    #reel-page { position: fixed; inset: 0; z-index: 9999; background: #000; }
    .reel-cerrar { position: absolute; top: 16px; left: 16px; z-index: 20; color: #fff; font-size: 28px; text-decoration: none; background: rgba(0,0,0,.4); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  </style>
  <div id="reel-page">
    <ReelPlayer client:load id={id} videoUrl={reel?.video_url || ''} titulo={reel?.titulo || ''} descripcion={reel?.descripcion || ''} />
    <a href="/" class="reel-cerrar">✕</a>
  </div>
</Layout>
