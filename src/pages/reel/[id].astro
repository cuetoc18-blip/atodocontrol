---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const { id } = Astro.params;

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

let reel = null;
if (id) {
  const { data } = await supabase.from('reels').select('*').eq('id', id).maybeSingle();
  reel = data;
}

const titulo = reel?.titulo || 'Reel | A Todo Control';
const descripcion = reel?.descripcion || 'Mira este reel en A Todo Control';
const imagen = reel?.imagen_url || 'https://atodocontrol.co/logo2.png';
const url = `https://atodocontrol.co/reel/${id}`;
---
<Layout title={titulo} description={descripcion} image={imagen} url={url}>
  <div id="reel-page">
    <div class="reel-box">
      <video id="reel-video" playsinline loop autoplay preload="auto"></video>
      <div class="reel-bottom">
        <div class="reel-info">
          <a href="/" class="reel-logo-link">
            <img src="/logo2.png" alt="A Todo Control" class="reel-logo" />
          </a>
          <div class="reel-nombre">A Todo Control</div>
        </div>
        <div class="reel-texto">
          <div class="reel-titulo" id="reel-titulo"></div>
          <div class="reel-desc" id="reel-desc"></div>
        </div>
      </div>
      <div class="reel-acciones">
        <button class="reel-like" id="reel-like">♡ <span id="like-count">0</span></button>
        <button class="reel-share" id="reel-share">↗</button>
      </div>
      <a href="/" class="reel-cerrar">✕</a>
    </div>
  </div>

  <script define:vars={{ id }}>
    let reels = [];
    let idx = 0;
    const preloaded = {};

    function preload(i) {
      if (i < 0 || i >= reels.length || preloaded[i]) return;
      const v = document.createElement('video');
      v.preload = 'auto';
      v.muted = true;
      v.playsInline = true;
      v.src = reels[i].video_url;
      v.load();
      preloaded[i] = v;
    }

    async function cargar() {
      const res = await fetch('/api/reels');
      reels = await res.json();
      idx = reels.findIndex(x => x.id === id);
      if (idx < 0) idx = 0;
      mostrar(idx);
      preload(idx + 1);
      preload(idx - 1);
      preload(idx + 2);
    }

    function mostrar(i) {
      if (i < 0 || i >= reels.length) return;
      idx = i;
      const r = reels[idx];
      history.replaceState(null, '', '/reel/' + r.id);

      const video = document.getElementById('reel-video');
      const cached = preloaded[i];

      if (cached && cached.readyState >= 2) {
        video.src = cached.src;
        video.currentTime = cached.currentTime || 0;
      } else {
        video.src = r.video_url;
      }
      video.play().catch(()=>{});

      document.getElementById('reel-titulo').textContent = r.titulo || '';
      document.getElementById('reel-desc').textContent = r.descripcion || '';
      cargarLikes(r.id);

      preload(idx + 1);
      preload(idx - 1);
      preload(idx + 2);
    }

    document.getElementById('reel-like').onclick = async (e) => {
      const btn = e.currentTarget;
      const r = reels[idx];
      if (!r) return;
      const res = await fetch('/api/reels-like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reel_id: r.id })
      });
      const data = await res.json();
      if (data.liked) {
        btn.innerHTML = '♥ <span id="like-count">' + data.likes + '</span>';
        btn.style.color = '#ff2d55';
      } else {
        btn.innerHTML = '♡ <span id="like-count">' + data.likes + '</span>';
        btn.style.color = '#fff';
      }
    };

    async function cargarLikes(reelId) {
      const res = await fetch('/api/reels-like?reel_id=' + reelId);
      const data = await res.json();
      const btn = document.getElementById('reel-like');
      if (data.liked) {
        btn.innerHTML = '♥ <span id="like-count">' + data.likes + '</span>';
        btn.style.color = '#ff2d55';
      } else {
        btn.innerHTML = '♡ <span id="like-count">' + data.likes + '</span>';
        btn.style.color = '#fff';
      }
    }

    document.getElementById('reel-share').onclick = () => {
      const r = reels[idx];
      const url = window.location.origin + '/reel/' + r.id;
      const texto = (r.titulo || '') + (r.descripcion ? '\n' + r.descripcion : '');
      if (navigator.share) {
        navigator.share({ title: r.titulo || 'Reel', text: texto, url }).catch(()=>{});
      } else {
        navigator.clipboard.writeText(texto + '\n' + url);
        alert('Enlace copiado');
      }
    };

    let startY = 0;
    const page = document.getElementById('reel-page');
    page.addEventListener('touchstart', e => { 
      if (e.target.closest('.reel-logo-link')) return;
      startY = e.touches[0].clientY; 
    }, {passive:true});
    page.addEventListener('touchend', e => {
      if (e.target.closest('.reel-logo-link')) return;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dy) > 40) {
        if (dy < 0) mostrar(idx + 1);
        else mostrar(idx - 1);
      }
    }, {passive:true});

    page.addEventListener('wheel', e => {
      if (e.deltaY > 30) mostrar(idx + 1);
      else if (e.deltaY < -30) mostrar(idx - 1);
    }, {passive:true});

    cargar();
  </script>

  <style>
    #reel-page {
      position: fixed;
      inset: 0;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .reel-box {
      position: relative;
      height: 100%;
      width: 100%;
    }
    @media (min-width: 700px) {
      .reel-box {
        height: 85vh;
        max-height: 85vh;
        width: auto;
        aspect-ratio: 9/16;
        max-width: 380px;
      }
    }
    #reel-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .reel-bottom {
      position: absolute;
      bottom: 16px;
      left: 12px;
      right: 56px;
      color: #fff;
      z-index: 5;
    }
    .reel-info {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .reel-logo-link {
      display: block;
      line-height: 0;
      z-index: 20;
      pointer-events: auto;
    }
    .reel-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      background: transparent;
      border: none;
    }
    .reel-nombre {
      font-weight: 700;
      font-size: .9rem;
      text-shadow: 0 1px 3px rgba(0,0,0,.6);
    }
    .reel-texto {
      text-shadow: 0 1px 3px rgba(0,0,0,.7);
    }
    .reel-titulo { font-weight: 700; margin-bottom: 4px; font-size: .92rem; }
    .reel-desc { font-size: .82rem; opacity: .95; line-height: 1.35; }
    .reel-acciones {
      position: absolute;
      right: 8px;
      bottom: 100px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .reel-like, .reel-share {
      background: none;
      border: none;
      color: #fff;
      font-size: 26px;
      cursor: pointer;
      text-shadow: 0 1px 4px rgba(0,0,0,.5);
    }
    .reel-cerrar {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(0,0,0,.5);
      color: #fff;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 18px;
      z-index: 10;
    }
  </style>
</Layout>
