---
import Layout from '../../layouts/Layout.astro';
import { supabase, esImagenReal, igPermalink, fechaEs, type Noticia } from '../lib/supabase';

const { id } = Astro.params;
const { data } = await supabase.from('noticias').select('*').eq('id', id).maybeSingle();
const n = data as Noticia | null;
if (!n) {
  return new Response('No encontrado', { status: 404 });
}

const pageUrl = `https://atodocontrol.co/articulo/${n.id}`;
const desc = (n.resumen || n.titulo || '').slice(0, 180);
const image = esImagenReal(n.imagen_url) ? n.imagen_url! : 'https://atodocontrol.co/og-default.jpg';
const ig = igPermalink(n.instagram_url) || igPermalink(n.contenido || '');
const fromText = String(n.contenido || '').match(/https?:\/\/(?:www\.)?instagram\.com\/(?:reel|p|tv)\/[A-Za-z0-9_-]+/i);
const igLink = ig || igPermalink(fromText ? fromText[0] : '');
const pars = String(n.contenido || '')
  .split('\n')
  .filter((p) => p.trim() && !/^https?:\/\/(?:www\.)?instagram\.com\//i.test(p.trim()))
  .map((p) => `<p>${p}</p>`)
  .join('');
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
const tw = `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(n.titulo || '')}`;
const wa = `https://api.whatsapp.com/send?text=${encodeURIComponent((n.titulo || '') + ' ' + pageUrl)}`;
---
<Layout title={`${n.titulo} | A Todo Control`} description={desc} image={image} url={pageUrl}>
  <a slot="header-extra" class="back" href="/">← Volver</a>
  <div class="article-wrap">
    <article class="article-card">
      {esImagenReal(n.imagen_url) && !igLink && <img class="article-image" src={n.imagen_url!} alt={n.titulo} />}
      <div class="article-body">
        <span class="category">{n.categoria || 'General'}</span>
        <h1>{n.titulo}</h1>
        {n.resumen && <p class="dek">{n.resumen}</p>}
        {igLink && (
          <div class="ig-embed">
            <iframe src={`${igLink}embed`} allowtransparency="true" allowfullscreen loading="lazy" title="Instagram"></iframe>
            <p style="text-align:center;margin-top:8px"><a href={igLink} target="_blank" rel="noopener">Ver en Instagram</a></p>
          </div>
        )}
        <div class="byline">
          <div class="byline-left">
            <img class="byline-logo" src="/logo.png" alt="A Todo Control" />
            <div>
              <div><strong>A Todo Control</strong></div>
              <div class="byline-date">{fechaEs(n.fecha_publicacion || n.created_at)}</div>
            </div>
          </div>
          <div class="share">
            <a href={fb} target="_blank" rel="noopener" title="Facebook"><img src="/share-facebook.png" alt="Facebook" /></a>
            <a href={tw} target="_blank" rel="noopener" title="X"><img src="/share-x.webp" alt="X" /></a>
            <a href={wa} target="_blank" rel="noopener" title="WhatsApp"><img src="/share-whatsapp.webp" alt="WhatsApp" /></a>
          </div>
        </div>
        <div class="content" set:html={pars} />
      </div>
    </article>
  </div>
</Layout>
<script define:vars={{ id: n.id }}>
  try {
    const k = 'vista_' + id;
    if (!sessionStorage.getItem(k)) {
      sessionStorage.setItem(k, '1');
      fetch('https://hlqdkosclnmmdhasoupt.supabase.co/rest/v1/rpc/increment_vistas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: 'sb_publishable_hw4WsIr-GvZU7PEu_KNNEw_tC-98Nst',
          Authorization: 'Bearer sb_publishable_hw4WsIr-GvZU7PEu_KNNEw_tC-98Nst',
        },
        body: JSON.stringify({ nid: id }),
      }).catch(() => {});
    }
  } catch (e) {}
</script>
