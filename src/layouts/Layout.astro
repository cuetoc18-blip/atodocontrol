---
const { title = 'A Todo Control', description = '', image = '', url = '' } = Astro.props;
---
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:url" content={url}>
  <link rel="icon" href="/favicon.ico">
  <style>
    body { margin: 0; font-family: system-ui, sans-serif; background: #f9fafb; }
    header { background: #1e293b; color: white; display: flex; align-items: center; padding: 12px 16px; }
    .logo { height: 40px; }
    #user-area { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .hamburger { background: none; border: none; color: white; font-size: 24px; cursor: pointer; margin-right: 12px; }
  </style>
</head>
<body>
  <header>
    <button class="hamburger" id="hamburger" type="button" aria-label="Menú">☰</button>
    <a href="/"><img src="/logo-sm.webp" alt="A Todo Control" class="logo"></a>
    <div id="user-area"></div>
  </header>

  <slot />

  <script>
    async function pintarUsuario() {
      const area = document.getElementById('user-area');
      if (!area) return;
      try {
        const res = await fetch('/api/sesion-usuario', { credentials: 'include' });
        if (!res.ok) {
          area.innerHTML = '<a href="/login" style="color:white;font-size:14px;font-weight:600;text-decoration:none;">Iniciar sesión</a>';
          return;
        }
        const data = await res.json();
        const inicial = (data.nombre || 'U').charAt(0).toUpperCase();
        const color = data.genero === 'f' ? '#db2777' : '#2563eb';
        area.innerHTML = `
          <div style="width:32px;height:32px;border-radius:50%;background:${color};color:white;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:14px">${inicial}</div>
          <span style="color:white;font-size:14px;">${data.nombre}</span>
        `;
      } catch (e) {
        area.innerHTML = '<a href="/login" style="color:white;font-size:14px;text-decoration:none;">Iniciar sesión</a>';
      }
    }
    pintarUsuario();
  </script>
</body>
</html>
