---
import '../styles/global.css';
const {
  title = 'A Todo Control',
  description = 'Medio de veeduría ciudadana y control político.',
  image = 'https://atodocontrol.co/og-default.jpg',
  url = 'https://atodocontrol.co/'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://hlqdkosclnmmdhasoupt.supabase.co" crossorigin />
  </head>
  <body>
    <header>
      <div class="header-container">
        <button class="hamburger" id="hamburger" aria-label="Menú" type="button">
          <span></span><span></span><span></span>
        </button>
        <a class="logo" href="/"><img src="/logo.png" alt="A Todo Control" /></a>
      </div>
      <nav class="menu-panel" id="menuPanel">
        <a href="/">Inicio</a>
        <a href="/?cat=Control%20Político">Control Político</a>
        <a href="/?cat=Política%20Local">Política Local</a>
        <a href="/?cat=Alcaldía">Alcaldía</a>
        <a href="/?cat=Seguridad">Seguridad</a>
        <a href="/?cat=Comunidad">Comunidad</a>
        <a href="/?cat=Opinión">Opinión</a>
      </nav>
    </header>
    <slot />
    <footer>
      <p><strong>A Todo Control</strong> · Medio de veeduría ciudadana y control político<br />© 2026</p>
    </footer>
    <script is:inline>
      const h = document.getElementById('hamburger');
      const m = document.getElementById('menuPanel');
      if (h && m) h.onclick = () => m.classList.toggle('open');
    </script>
  </body>
</html>
